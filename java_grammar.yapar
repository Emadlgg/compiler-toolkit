/* ================================================ */
/*     Especificacion sintactica de Java            */
/*     Para YAPar - Generador de Parsers            */
/* ================================================ */

%token KW_PUBLIC KW_PRIVATE KW_PROTECTED KW_STATIC KW_FINAL
%token KW_CLASS KW_VOID KW_INT KW_DOUBLE KW_BOOLEAN KW_CHAR
%token KW_FLOAT KW_LONG KW_SHORT KW_BYTE
%token KW_IF KW_ELSE KW_WHILE KW_FOR KW_RETURN
%token KW_NEW KW_THIS KW_NULL KW_TRUE KW_FALSE
%token KW_BREAK KW_CONTINUE KW_SWITCH KW_CASE KW_DEFAULT
%token KW_TRY KW_CATCH KW_FINALLY KW_THROW KW_THROWS
%token KW_EXTENDS KW_IMPLEMENTS KW_INTERFACE KW_ABSTRACT
%token KW_IMPORT KW_PACKAGE KW_SUPER KW_INSTANCEOF
%token ID INT_LIT FLOAT_LIT STRING_LIT CHAR_LIT
%token OP_PLUS OP_MINUS OP_TIMES OP_DIV OP_MOD
%token OP_ASSIGN OP_EQ OP_NEQ OP_LT OP_GT OP_LEQ OP_GEQ
%token OP_AND OP_OR OP_NOT OP_INC OP_DEC
%token OP_PLUS_ASSIGN OP_MINUS_ASSIGN OP_TIMES_ASSIGN OP_DIV_ASSIGN
%token OP_BITAND OP_BITOR OP_XOR OP_LSHIFT OP_RSHIFT
%token LPAREN RPAREN LBRACE RBRACE LBRACKET RBRACKET
%token SEMICOLON COMMA DOT AT OP_COLON
%token _WS _LINE_CMT _BLOCK_CMT

IGNORE _WS
IGNORE _LINE_CMT
IGNORE _BLOCK_CMT

%%

/* ---- Programa ---- */
program:
    class_decl
;

/* ---- Clase ---- */
class_decl:
    modifier KW_CLASS ID LBRACE class_body RBRACE
  | KW_CLASS ID LBRACE class_body RBRACE
  | modifier KW_CLASS ID KW_EXTENDS ID LBRACE class_body RBRACE
  | KW_CLASS ID KW_EXTENDS ID LBRACE class_body RBRACE
;

class_body:
    class_body member_decl
  |
;

/* ---- Miembros ---- */
member_decl:
    method_decl
  | field_decl
;

/* ---- Campos ---- */
field_decl:
    modifier type ID SEMICOLON
  | modifier type ID OP_ASSIGN expr SEMICOLON
  | type ID SEMICOLON
  | type ID OP_ASSIGN expr SEMICOLON
;

/* ---- Modificadores ---- */
modifier:
    KW_PUBLIC
  | KW_PRIVATE
  | KW_PROTECTED
  | KW_STATIC
  | KW_FINAL
  | KW_ABSTRACT
  | KW_PUBLIC KW_STATIC
  | KW_PRIVATE KW_STATIC
  | KW_PUBLIC KW_STATIC KW_FINAL
  | KW_PUBLIC KW_FINAL
;

/* ---- Tipos ---- */
type:
    KW_INT
  | KW_DOUBLE
  | KW_BOOLEAN
  | KW_CHAR
  | KW_FLOAT
  | KW_LONG
  | KW_SHORT
  | KW_BYTE
  | KW_VOID
  | ID
  | KW_INT LBRACKET RBRACKET
  | KW_DOUBLE LBRACKET RBRACKET
  | KW_BOOLEAN LBRACKET RBRACKET
  | KW_CHAR LBRACKET RBRACKET
  | ID LBRACKET RBRACKET
;

/* ---- Métodos ---- */
method_decl:
    modifier type ID LPAREN param_list RPAREN block
  | modifier type ID LPAREN RPAREN block
  | type ID LPAREN param_list RPAREN block
  | type ID LPAREN RPAREN block
  | modifier type ID LPAREN param_list RPAREN SEMICOLON
  | modifier type ID LPAREN RPAREN SEMICOLON
;

/* ---- Parámetros ---- */
param_list:
    param_list COMMA param
  | param
;

param:
    type ID
;

/* ---- Bloque ---- */
block:
    LBRACE stmt_list RBRACE
;

/* ---- Lista de sentencias ---- */
stmt_list:
    stmt_list stmt
  |
;

/* ---- Sentencias ---- */
stmt:
    expr SEMICOLON
  | type ID SEMICOLON
  | type ID OP_ASSIGN expr SEMICOLON
  | ID OP_ASSIGN expr SEMICOLON
  | ID OP_PLUS_ASSIGN expr SEMICOLON
  | ID OP_MINUS_ASSIGN expr SEMICOLON
  | ID OP_TIMES_ASSIGN expr SEMICOLON
  | ID OP_DIV_ASSIGN expr SEMICOLON
  | KW_IF LPAREN expr RPAREN block
  | KW_IF LPAREN expr RPAREN block KW_ELSE block
  | KW_WHILE LPAREN expr RPAREN block
  | KW_FOR LPAREN for_init SEMICOLON expr SEMICOLON for_update RPAREN block
  | KW_RETURN expr SEMICOLON
  | KW_RETURN SEMICOLON
  | KW_BREAK SEMICOLON
  | KW_CONTINUE SEMICOLON
  | block
;

/* ---- For init/update ---- */
for_init:
    type ID OP_ASSIGN expr
  | ID OP_ASSIGN expr
  |
;

for_update:
    ID OP_INC
  | ID OP_DEC
  | ID OP_ASSIGN expr
  |
;

/* ---- Expresiones ---- */
expr:
    expr OP_PLUS term
  | expr OP_MINUS term
  | expr OP_EQ term
  | expr OP_NEQ term
  | expr OP_LT term
  | expr OP_GT term
  | expr OP_LEQ term
  | expr OP_GEQ term
  | expr OP_AND term
  | expr OP_OR term
  | term
;

/* ---- Términos ---- */
term:
    term OP_TIMES factor
  | term OP_DIV factor
  | term OP_MOD factor
  | factor
;

/* ---- Factores ---- */
factor:
    LPAREN expr RPAREN
  | ID
  | INT_LIT
  | FLOAT_LIT
  | STRING_LIT
  | CHAR_LIT
  | KW_TRUE
  | KW_FALSE
  | KW_NULL
  | KW_THIS
  | OP_NOT factor
  | OP_MINUS factor
  | ID DOT ID
  | ID LBRACKET expr RBRACKET
  | ID LPAREN arg_list RPAREN
  | ID LPAREN RPAREN
  | ID DOT ID LPAREN arg_list RPAREN
  | ID DOT ID LPAREN RPAREN
  | KW_NEW ID LPAREN arg_list RPAREN
  | KW_NEW ID LPAREN RPAREN
  | KW_NEW type LBRACKET expr RBRACKET
;

/* ---- Argumentos ---- */
arg_list:
    arg_list COMMA expr
  | expr
;