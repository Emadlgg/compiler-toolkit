// Condiciones constantes (no debe quedar código inalcanzable) y variables con nombre de instrucción
let cond: boolean = true && false;
let neg: boolean = !cond;
let otra: boolean = false || true;
let concat: string = "a" + "b";
let len: integer = 3;
let t0: integer = 7;
print(cond);
print(neg);
print(otra);
print(concat);
print(len + t0);
